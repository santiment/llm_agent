# Any OpenAI-compatible endpoint. Default is OpenRouter (model-agnostic).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...

# Web search
TAVILY_API_KEY=tvly-...

# Models: pick a named price package — extra-low | low | mid | high (MODEL_TIERS in
# config.py; see README "Model tiers"). Sets all three model slots together.
# Default when unset: extra-low (cheapest; fine for trying things out, weak for real
# research — opt up for real work). This is the ONLY model knob: individual models
# are deliberately not settable per env var or per run — to change which models a
# tier means, edit MODEL_TIERS in code (one reviewed place).
DRA_MODEL_TIER=mid

# Per-request ceiling (seconds) and retry count on every model call. The timeout keeps one
# stalled upstream request from pinning a research unit for the whole run; the retries cover
# transient 429/5xx from the gateway. DRA_MAX_RETRIES=0 disables retrying.
# DRA_REQUEST_TIMEOUT=180
# DRA_MAX_RETRIES=3

# Wall-clock ceiling per run (seconds): wrap-up nudge at 75%, hard stop at 100%. Keep the
# sandbox session (LLM_SANDBOX_SESSION_TIMEOUT, default 5400) longer than this.
# DRA_MAX_RUN_SECONDS=2700
# Sampling temperature and per-call output cap (tokens). Temperature 0 (greedy) is what sends
# small models into endless repetition; the cap bounds how far one such response can run
# before the runaway guard trims it and nudges the model on (0 = no cap).
# DRA_TEMPERATURE=0.3
# DRA_MAX_OUTPUT_TOKENS=16000

# Domain prompt: deployment-specific guidance (analytical dimensions, terminology,
# example asks) injected into both system prompts as a DOMAIN CONTEXT block. The base
# prompts stay domain-neutral; put all domain color here. File is the usual form for
# anything longer than a sentence; inline DRA_DOMAIN_PROMPT wins if both are set.
# DRA_DOMAIN_PROMPT=
# DRA_DOMAIN_PROMPT_FILE=./domain.md

# Single server: DRA_MCP_URL (+ optional DRA_MCP_LABEL for the Sources name).
DRA_MCP_URL=http://127.0.0.1:8765
DRA_MCP_LABEL=
# Credentials for the MCP server, sent as `Authorization: Bearer <value>` on every call.
# Most servers (Santiment's included) let an anonymous client `initialize` and list tools,
# then reject every tools/call with HTTP 401 — so a missing token looks healthy at startup
# and fails only when the model calls a tool. Santiment accepts an API key here as well.
DRA_MCP_BEARER=
# Tool listings are reused across runs for this many seconds (0 = re-list every run; set
# while changing the MCP server's tool schemas).
# DRA_MCP_TOOLS_TTL=600
# Multiple servers: DRA_MCP_SERVERS:
# DRA_MCP_SERVERS=[{"label":"Data MCP","url":"http://127.0.0.1:8765/mcp"},{"label":"Another Data MCP","url":"http://127.0.0.1:8766/mcp"}]

# Code-execution sandbox sidecar (llm_sandbox). The agent is the caller: it sends
# LLM_SANDBOX_TOKEN as `Authorization: Bearer` to LLM_SANDBOX_URL. The token MUST equal the
# sandbox service's LLM_SANDBOX_TOKEN (empty on both = auth disabled, for local dev).
# Set → the sandbox becomes the agent's filesystem backend and the `execute` tool turns on;
# unset → in-memory files, no execution. Run the service from the llm-sandbox repo.
LLM_SANDBOX_URL=http://127.0.0.1:8900
LLM_SANDBOX_TOKEN=

# Native social_messages tool (drop-in from custom_tools/). Direct POST to
# metrics-hub /sample_documents — unset = tool not loaded. DRA_SAMPLE_MAX_WORDS is the
# sampled-text budget in WORDS the tool requests (metrics-hub's `max_words` param); the
# server clamps it to its own ceiling (400k words). Large samples are offloaded to a
# sandbox file and processed with `execute`.
DRA_METRICS_HUB_URL=http://localhost:3000
DRA_SAMPLE_MAX_WORDS=100000

# ---- LangGraph dev server ----
# Concurrent runs the dev server executes at once (`--n-jobs-per-worker`). Without the
# flag `langgraph dev` runs ONE at a time (its --help says 10; the code falls back to 1),
# so a single slow/hung run queues every later run as `pending` forever and the UI shows
# "finished without producing a report". run.sh passes this through.
# DRA_JOBS=10
# Auto-reload on source changes. Off by default: each save restarts the server and kills
# every in-flight run (the UI then shows the same "finished without a report" error).
# DRA_RELOAD=0
# `langgraph dev` pickles threads, checkpoints and in-flight runs to ./.langgraph_api/ and
# reloads them on start, so a run that was executing when the server stopped resumes by
# itself, with no client attached. The host app cancels such leftovers before starting a
# new turn on the thread, so the default is fine. Set to true to start empty every time —
# at the cost of forgetting every thread on restart (follow-ups on older sessions fail).
# LANGGRAPH_DISABLE_FILE_PERSISTENCE=false
